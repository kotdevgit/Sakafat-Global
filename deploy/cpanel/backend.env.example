# ==============================================================================
# Sakafat Global — cPanel Shared Backend Environment ($APP_ROOT/shared/backend.env)
# ==============================================================================
# In cPanel, place this file at:
#   /home/YOUR_CPANEL_USER/sakafat-app/shared/backend.env
# Secure permissions:
#   chmod 600 /home/YOUR_CPANEL_USER/sakafat-app/shared/backend.env
# ==============================================================================

# Security
SECRET_KEY=replace-with-a-random-64-character-string
DEBUG=False
ALLOWED_HOSTS=sakafat.com,www.sakafat.com,api.sakafat.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://sakafat.com,https://www.sakafat.com,https://api.sakafat.com

# Database (cPanel PostgreSQL or MySQL)
DB_NAME=YOUR_CPANEL_USER_sakafat
DB_USER=YOUR_CPANEL_USER_dbuser
DB_PASSWORD=your-cpanel-database-password
DB_HOST=localhost
DB_PORT=5432

# Production Email (cPanel Webmail or SMTP Provider)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAIL_MAILER=smtp
MAIL_HOST=mail.sakafat.com
MAIL_PORT=587
MAIL_USERNAME=noreply@sakafat.com
MAIL_PASSWORD=your-cpanel-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sakafat.com
MAIL_FROM_NAME="Sakafat Global"
CONTACT_NOTIFICATION_EMAIL=info@sakafat.com

# CORS
CORS_ALLOWED_ORIGINS=https://sakafat.com,https://www.sakafat.com
