# ==============================================================================
# Sakafat Global — cPanel Shared Frontend Environment ($APP_ROOT/shared/frontend.env)
# ==============================================================================
# In cPanel, place this file at:
#   /home/YOUR_CPANEL_USER/sakafat-app/shared/frontend.env
# Secure permissions:
#   chmod 600 /home/YOUR_CPANEL_USER/sakafat-app/shared/frontend.env
# ==============================================================================

# Public API URL (Accessible to client browser)
NEXT_PUBLIC_API_BASE_URL=https://sakafat.com/api/

# Internal Django API endpoint for Next.js SSR & Server Actions
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api/
