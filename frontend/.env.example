# ==============================================================================
# Sakafat Global — Frontend Environment Variables (Local Development)
# ==============================================================================

# Public Django API base URL (used by Next.js for resolving media/image URLs).
# Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/

# Internal server-to-server Django endpoint used by Next.js Server Components,
# route handlers, and proxy endpoints.
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api/

# Optional deployment identifier reported by the /api/health endpoint.
RELEASE_ID=local-development
