# ==============================================================================
# Sakafat Global — Next.js Frontend Production Environment Template
# ==============================================================================
# Copy this file to .env.production in your production frontend directory:
#   cp .env.production.example .env.production
# (Or in cPanel, put it in $APP_ROOT/shared/frontend.env)
# ==============================================================================

# Public Django API URL — Used for generating absolute links or resolving public media.
# In production with Nginx / cPanel BFF proxy, this points to your public domain's /api/ path:
NEXT_PUBLIC_API_BASE_URL=https://sakafat.com/api/

# Internal server-to-server endpoint used by Next.js Server Components and BFF Route Handlers.
# - On VPS (Django on Gunicorn port 8000): http://127.0.0.1:8000/api/
# - On Docker Compose: http://backend:8000/api/
# - On cPanel with Phusion Passenger Python app: http://127.0.0.1:8000/api/ (or internal socket)
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api/

# Optional: Release tag or Git commit SHA reported by the /api/health endpoint.
# In GitHub Actions cPanel deployment, this is automatically set by the deployment script.
RELEASE_ID=v1.0.0-production
