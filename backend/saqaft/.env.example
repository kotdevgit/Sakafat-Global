SECRET_KEY=your-secret-key
DEBUG=True

DB_NAME=saqaft_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Local development: write emails to backend/.local/emails instead of sending.
# Switch to django.core.mail.backends.smtp.EmailBackend once the MAIL_* values below
# point at a reachable mail server. Without this line Django tries real SMTP and
# every registration fails with a connection error.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend

# The browser never calls Django directly — the Next.js routes proxy server-side —
# so this stays empty locally and deployments opt in explicitly.
CORS_ALLOWED_ORIGINS=

MAIL_MAILER=smtp
MAIL_HOST=your-mail-host
MAIL_PORT=587
MAIL_USERNAME=your-email
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email
MAIL_FROM_NAME=saqaft