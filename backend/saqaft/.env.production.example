# ==============================================================================
# Sakafat Global — Django Backend Production Environment Template
# ==============================================================================
# Copy this file to .env in your production backend directory:
#   cp .env.production.example .env
# Fill in your production credentials and secure secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Generate a cryptographically strong 64-character secret key:
# python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-cryptographically-strong-random-secret-key-min-50-chars

# MUST ALWAYS BE False IN PRODUCTION!
DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve:
# Include your public domain, API subdomain, and internal loopback for Next.js BFF proxy
ALLOWED_HOSTS=sakafat.com,www.sakafat.com,api.sakafat.com,127.0.0.1,localhost

# Comma-separated origins for CSRF protection over HTTPS (required for Django 4+ admin login):
# Include the full URI with scheme (https://)
CSRF_TRUSTED_ORIGINS=https://sakafat.com,https://www.sakafat.com,https://api.sakafat.com

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16+)
# ------------------------------------------------------------------------------
DB_NAME=sakafat_production
DB_USER=sakafat_user
DB_PASSWORD=replace-with-a-secure-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
# In production, use standard SMTP backend to send OTPs and contact notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailprovider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sakafat.com
MAIL_FROM_NAME="Sakafat Global"
CONTACT_NOTIFICATION_EMAIL=info@sakafat.com

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# The Next.js frontend proxies API calls server-side in BFF architecture.
# If direct browser access to Django API is ever needed, specify frontend origins:
CORS_ALLOWED_ORIGINS=https://sakafat.com,https://www.sakafat.com
